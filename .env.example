# Example configuration for amex-mcp. Every value here is a placeholder.
#
# Nothing reads this file automatically. Copy it to .env (which is git-ignored), fill in what you
# need, and start the server with:  uv run --env-file .env amex-mcp
# Never commit a file that contains real values. See the Configuration table in README.md for what
# each variable does.

# --- Data source -----------------------------------------------------------------------------
# AMEX_PROVIDER=
# AMEX_MAX_RANGE_DAYS=400

# --- Statement-file route (no third party) ---------------------------------------------------
# AMEX_IMPORT_DIR=
# AMEX_IMPORT_ACCOUNT_ID=amex-import
# AMEX_IMPORT_CURRENCY=GBP
# AMEX_CSV_CHARGES_POSITIVE=true
# AMEX_OFX_CHARGES_NEGATIVE=true
# AMEX_CSV_DATE_ORDER=dmy

# --- TrueLayer route (register your own TrueLayer application) -------------------------------
# TRUELAYER_CLIENT_ID=
# TRUELAYER_CLIENT_SECRET=
# TRUELAYER_ENV=live
# TRUELAYER_REDIRECT_URI=http://localhost:3000/callback
# TRUELAYER_PROVIDERS=
# TRUELAYER_TOKEN_ENCODING=json
# TRUELAYER_WINDOW_DAYS=88
# AMEX_TRUELAYER_REFRESH_TOKEN=
# AMEX_TOKEN_STORE=file
# AMEX_TOKEN_FILE=

# --- Transport -------------------------------------------------------------------------------
# AMEX_MCP_TRANSPORT=stdio
# AMEX_MCP_HOST=127.0.0.1
# AMEX_MCP_PORT=8000
# AMEX_MCP_PATH=/mcp
# AMEX_MCP_AUTH_TOKEN=
# AMEX_MCP_ALLOW_NO_AUTH=
# AMEX_MCP_ALLOWED_HOSTS=
# AMEX_MCP_ALLOWED_ORIGINS=
# AMEX_MCP_LOG_LEVEL=WARNING

# --- Test hooks: leave unset in normal use ---------------------------------------------------
# TRUELAYER_AUTH_BASE=
# TRUELAYER_API_BASE=
